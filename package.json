{
  "name": "@pankleks/pgdev",
  "version": "0.5.10",
  "description": "A desktop IDE for PostgreSQL with a schema-aware editor, paged results and AI integration.",
  "private": true,
  "main": "desktop/main.mjs",
  "desktopName": "pgdev.desktop",
  "keywords": [
    "postgresql",
    "postgres",
    "ide",
    "sql",
    "database",
    "editor",
    "monaco"
  ],
  "homepage": "https://github.com/pankleks/pgdev#readme",
  "bugs": {
    "url": "https://github.com/pankleks/pgdev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pankleks/pgdev.git"
  },
  "author": "Krzysztof Heim <krzysztof.heim@gmail.com>",
  "license": "MIT",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:desktop && node desktop/scripts/dev.mjs",
    "build": "npm run build:web && npm run build:server && npm run build:desktop",
    "start": "electron .",
    "test": "npm run build:server && node test/run.mjs",
    "test:unit": "npm run build:server && node test/run.mjs --unit",
    "build:web": "npm run build --workspace web",
    "build:server": "cd server && tsc",
    "build:desktop": "node desktop/scripts/build.mjs",
    "test:desktop": "node --test test/desktop/*.test.mjs",
    "test:desktop:smoke": "node desktop/scripts/smoke.mjs",
    "test:desktop:svelte": "node desktop/scripts/svelte-smoke.mjs",
    "test:desktop:tree": "node test/desktop/tree.mjs",
    "package:desktop": "npm run build && electron-builder --config desktop/electron-builder.yml --publish never",
    "package:desktop:dir": "npm run build && electron-builder --config desktop/electron-builder.yml --dir --publish never"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "concurrently": "^9.1.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "playwright": "^1.63.0",
    "postject": "^1.0.0-alpha.6",
    "svelte": "^5.57.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
